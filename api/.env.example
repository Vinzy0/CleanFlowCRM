# Direct backend runs (uvicorn app.main:app from api/). The repository-root .env
# is read as a fallback, so most values can live there.
DATABASE_URL=postgresql+psycopg://cleanflow:cleanflow@localhost:5432/cleanflow
JWT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Acme Cleaning Services <no-reply@example.com>
OWNER_NOTIFICATION_EMAIL=owner@example.com
DEMO_MODE=false
DEMO_EMAIL_OVERRIDE=
