# Local Docker Compose values only. Replace JWT_SECRET before running.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://cleanflow:replace-with-local-password@db:5432/cleanflow
JWT_SECRET=
# Separate Fernet key shared by API and webhook worker; store securely, never print.
INTEGRATION_ENCRYPTION_KEY=
RATE_LIMIT_INTEGRATION=120
RATE_LIMIT_INTEGRATION_WINDOW_SECONDS=60
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Email (Phase 4). EMAIL_TRANSPORT=resend delivers through Resend.
# EMAIL_TRANSPORT=log captures messages in EMAIL_LOG_PATH instead of delivering.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Acme Cleaning Services <no-reply@example.com>
OWNER_NOTIFICATION_EMAIL=owner@example.com
EMAIL_LOG_PATH=
# Base URL used for the "Open in the CRM" link inside owner notifications.
CRM_PUBLIC_URL=http://127.0.0.1:3000

# Public demo mode (Phase 5). DEMO_MODE=true enables the simulate/reset endpoints.
# Set DEMO_EMAIL_OVERRIDE to an inbox you control. With demo mode on and no
# override, the backend refuses to send any email at all.
DEMO_MODE=false
DEMO_EMAIL_OVERRIDE=
DEMO_REUSE_AI_RESULTS=true

# Rate limits (requests per window, per address). Windows are in seconds and
# default to 3600, except simulate (600) and login (300).
RATE_LIMIT_INQUIRY=20
RATE_LIMIT_SIMULATE=5
RATE_LIMIT_CLASSIFY=10
RATE_LIMIT_DRAFT=10
RATE_LIMIT_EMAIL=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_RESET=3
# Set RATE_LIMIT_<BUCKET>_WINDOW_SECONDS to change a window.

# Only enable this behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
